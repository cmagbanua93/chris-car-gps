# Copy these into Railway > your service > Variables. Never commit real values.
DASHBOARD_PASSWORD=choose-a-strong-password

SOURCE_1_NAME=Expedite
SOURCE_1_URL=https://expeditetracker.com
SOURCE_1_USERNAME=
SOURCE_1_PASSWORD=

SOURCE_2_NAME=Vectras
SOURCE_2_URL=https://wtracklite2.vectras-inc.com
SOURCE_2_USERNAME=
SOURCE_2_PASSWORD=

# Optional
POLL_SECONDS=30            # how often each GPS site is read (minimum 20)
OFFLINE_MINUTES=60         # no update for this long = offline alert
SPEED_LIMIT_KMH=80
POWER_CUT_VOLTS=9          # car power below this = "tracker unplugged" alert
NIGHT_START_HOUR=0         # night-use alert window, local time
NIGHT_END_HOUR=5
ZONES=Home:10.2433,123.7885,300;Office:10.3157,123.8854,200
TZ_OFFSET=+08:00
TIME_ZONE=Asia/Manila
DATA_DIR=/data             # mount a Railway volume here
KEEP_DAYS=365
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
